# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=wic
DB_PASSWORD=wic_dev_password
DB_NAME=whereischurch
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# Auth
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRY_HOURS=24

# Server
PORT=8080
ENVIRONMENT=development
COOKIE_SECURE=false

# Storage: "local" (filesystem) or "s3" (AWS S3 / MinIO / DigitalOcean Spaces)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
MAX_UPLOAD_SIZE_MB=10

# Auto-seed: import churches from OpenStreetMap on first startup when DB is empty
AUTO_SEED=true
SEED_COUNTRY=BR

# MassTimes.org API (optional — enriches Catholic church data with mass times)
# Request your key at: https://apiv4.updateparishdata.org/
# MASSTIMES_API_KEY=your-key-here

# S3 settings (only when STORAGE_DRIVER=s3)
# S3_BUCKET=where-is-church-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=                    # custom endpoint for MinIO, etc.
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
